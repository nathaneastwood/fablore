# Build output
book

# Rewritten by the hints preprocessor on every build. The file is committed
# (and kept current by the ensure-hints-json-sync hook); this entry exists so
# `mdbook serve` does not see its own rebuild and loop.
src/hints.json

# Runtime database, seeded from src/data/csv/ on first open
src/data/fablore.db

# Media. Lore images and video live on S3, not in git.
*.webp
*.mp4
*.png

# Site branding assets (exceptions to *.webp / *.png)
!src/assets/favicon.webp
!src/assets/favicon.png
!src/assets/apple-touch-icon.png
!src/assets/logo_transparent.png
!src/assets/logo_transparent_white.png
!src/assets/logo_original_cropped.png

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage*

# Local tooling and editor state
fablore.code-workspace
.envrc
.DS_Store
.claude
CLAUDE.md
plans/
